PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Optional: improves GitHub clone access for private repos or rate-limited environments.
GITHUB_TOKEN=

# Model used when a user enters their own Groq API key in the UI.
GROQ_MODEL=llama-3.3-70b-versatile

# Repository ingestion limits.
MAX_REPO_FILES=220
MAX_REPO_BYTES=260000
MAX_FILE_BYTES=12000
